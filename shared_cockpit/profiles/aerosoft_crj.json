 "lvar_classes": [
  {
   "re": "^ASCRJ_FCP_\\w+_(SEL|CHANGE)$",
   "class": "ignore",
   "why": "knob animation position / turn-direction pulse (knobs below sync the value)"
  },
  {
   "re": "^ASCRJ_MCDU[12]_(?!INPUT$)\\w+$",
   "class": "press",
   "rest": 0,
   "hold_ms": 100,
   "why": "MCDU keys: 1 while pressed"
  },
  {
   "re": "^ASCRJ_FCP_(AP_ENG|AP_DISC|HDG|ALT|VS|SPEED|NAV|APPR|BANK|HALF_BANK|FD\\d?|XFR|CRS\\d?_PUSH)$",
   "class": "press",
   "rest": 0,
   "hold_ms": 100,
   "why": "autopilot panel push buttons"
  },
  {
   "re": "^ASCRJ_(FLAPS_SET|SPOILER_SET|PARK_BRAKE|OVHD_NO_SMOKING|OVHD_SEAT_BELTS|GPWS_TERR_GUARD\\w*|CPT_ARMREST|FO_ARMREST|FIRE_TEST\\w*)$",
   "class": "ignore",
   "why": "driven by an input event that already syncs"
  },
  {
   "re": "^ASCRJ_(ELEVATOR|AILERON_\\w+|RUDDER|ELEVTRIM|GEAR_NWS|AOA_VANE|TQ_THROTTLE_\\d_POS)$",
   "class": "ignore",
   "why": "surfaces/levers follow the flying pilot's controls"
  },
  {
   "re": "^(SLATS|FLAPS|SPLR)_\\w+_POS$|^WINGFLEX_\\w+$",
   "class": "ignore",
   "why": "animation"
  }
 ],
 "knobs": [
  {
   "value": "ASCRJ_FCP_ALT_INFO",
   "step": "ASCRJ_FCP_ALT_CHANGE",
   "up": 1,
   "down": -1,
   "rest": 0
  },
  {
   "value": "ASCRJ_FCP_HDG_INFO",
   "step": "ASCRJ_FCP_HDG_CHANGE",
   "up": 1,
   "down": -1,
   "rest": 0,
   "wrap": 360
  },
  {
   "value": "ASCRJ_FCP_SPEED_INFO",
   "step": "ASCRJ_FCP_SPEED_CHANGE",
   "up": 1,
   "down": -1,
   "rest": 0
  },
  {
   "value": "ASCRJ_FCP_WHEEL_INFO",
   "step": "ASCRJ_FCP_WHEEL_CHANGE",
   "up": 1,
   "down": -1,
   "rest": 0
  }
 ],
 "default_class": "state",
 "switches_off": [
  "lt_*",
  "elev_trim",
  "rudder_trim",
  "flaps",
  "spoilers",
  "spoilers_arm",
  "park_brake",
  "ap_*"
 ],
 "k_relay": false,
 "schema": 2
}